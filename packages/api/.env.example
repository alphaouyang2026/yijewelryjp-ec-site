# Local settings of the API (`npm run dev`, `npm run db:seed`).
# Copy this file to packages/api/.env and fill in what you need; .env is not
# committed. Every setting is optional: commented out, it takes the default
# shown. Restart `npm run dev` after changing .env. README "环境变量" explains each.

# Stripe's test mode: a test secret key (sk_test_…) from the Stripe dashboard.
# Without it, checkout goes straight to the thank-you page (README "本地结账").
# STRIPE_SECRET_KEY=sk_test_...
# The signing secret `stripe listen` shows (whsec_…), for the events it forwards.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where new order notices go. Locally, every email is printed to the API's console, not sent.
# OWNER_NOTIFICATION_EMAIL=owner@localhost

# The email address the admin signs you in as.
# DEV_OWNER_EMAIL=owner@localhost

# Shipping, in yen, tax included.
# SHIPPING_FEE_YEN=800
# FREE_SHIPPING_THRESHOLD_YEN=20000

# The key that signs the admin's session cookie.
# SESSION_SECRET=local-development-session-secret

# DynamoDB Local and the table in it.
# DYNAMODB_ENDPOINT=http://localhost:8100
# TABLE_NAME=yijewelry-local
